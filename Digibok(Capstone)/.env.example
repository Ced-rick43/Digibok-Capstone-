# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: Signing key for auth tokens. If unset, a random secret is generated
# at server startup (sessions won't survive restarts). Set this for a stable deploy.
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"

# DATABASE_URL: PostgreSQL connection string. Required — there is no fallback.
DATABASE_URL="postgres://digibok:digibok@localhost:5432/digibok"

# PORT: Port the server listens on. Hosted platforms (Railway, Render, Fly) set this
# themselves and route traffic to it — leave it unset there. Defaults to 3000 locally.
PORT="3000"

# DATABASE_SSL: Set to "true" when DATABASE_URL points at managed Postgres reached over
# the public internet (Railway's proxy host, Neon, Supabase), which requires TLS. Leave
# unset for a local server or Railway's internal network, which need no TLS.
DATABASE_SSL="false"
